// Placeholder Cortex-M platform. Replace addresses/peripherals after MCU is frozen.
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: true
memory: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00100000
ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00040000
uart: UART.PL011 @ sysbus 0x40000000
    -> sysbus
